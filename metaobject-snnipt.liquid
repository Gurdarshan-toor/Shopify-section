<style>
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }
  .spec-table th,
  .spec-table td {
    border: 1px solid #333;
    padding: 8px 12px;
    text-align: left;
  }
  .spec-table th {
    width: 40%;
  }
  .spec-heading {
    font-size: 18px;
    font-weight: 700;
    margin: 20px 0 10px;
    padding-bottom: 5px;
  }
</style>

{% assign show_specs = false %}

{% if product.metafields.custom.weight_in_carats %}
  {% assign show_specs = true %}
{% endif %}
{% if product.metafields.custom.measurements_in_mm %}
  {% assign show_specs = true %}
{% endif %}
{% if product.metafields.custom.gemstone_variety %}
  {% assign show_specs = true %}
{% endif %}
{% if product.metafields.custom.cut %}
  {% assign show_specs = true %}
{% endif %}
{% if product.metafields.custom.shape %}
  {% assign show_specs = true %}
{% endif %}
{% if product.metafields.custom.carving_technique %}
  {% assign show_specs = true %}
{% endif %}

{% if show_specs %}
  <h3 class="spec-heading">Specifications</h3>
  <table class="spec-table">
    {% if product.metafields.custom.weight_in_carats %}
      <tr>
        <th>Weight in Carats</th>
        <td>{{ product.metafields.custom.weight_in_carats }}</td>
      </tr>
    {% endif %}

    {% if product.metafields.custom.measurements_in_mm %}
      <tr>
        <th>Measurements in mm</th>
        <td>{{ product.metafields.custom.measurements_in_mm }}</td>
      </tr>
    {% endif %}

    {% if product.metafields.custom.gemstone_variety %}
      {% assign gem = product.metafields.custom.gemstone_variety.value %}
      {% if gem %}
        <tr>
          <th>Gemstone Variety</th>
          <td>{{ gem.title }}</td>
        </tr>
      {% endif %}
    {% endif %}

    {% if product.metafields.custom.cut %}
      {% assign cut = product.metafields.custom.cut.value %}
      {% if cut %}
        <tr>
          <th>Cut</th>
          <td>{{ cut.title }}</td>
        </tr>
      {% endif %}
    {% endif %}

    {% if product.metafields.custom.shape %}
      {% assign shape = product.metafields.custom.shape.value %}
      {% if shape %}
        <tr>
          <th>Shape</th>
          <td>{{ shape.title }}</td>
        </tr>
      {% endif %}
    {% endif %}

    {% if product.metafields.custom.carving_technique %}
      <tr>
        <th>Carving Technique</th>
        <td>
          {% for carving in product.metafields.custom.carving_technique.value %}
            {{ carving.title }}{% unless forloop.last %}, {% endunless %}
          {% endfor %}
        </td>
      </tr>
    {% endif %}
  </table>
{% endif %}
