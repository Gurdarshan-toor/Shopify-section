<div class="tji-logo-slider-section">
  <div class="page-width">
    <div class="tji-section-header">
      {% if section.settings.heading != blank %}
        <h2 class="tji-section-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="tji-logo-slider-wrapper">
      <div class="tji-logo-slider-track" data-tji-logo-slider>
        {% for i in (1..2) %}
          {% for block in section.blocks %}
            <div class="tji-logo-slide" {{ block.shopify_attributes }}>
              {% if block.settings.logo_image != blank %}
                <div class="tji-logo-image-wrapper">
                  <img 
                    src="{{ block.settings.logo_image | image_url: width: 250 }}" 
                    alt="{{ block.settings.logo_alt | escape }}"
                    class="tji-logo-image"
                    loading="lazy"
                    width="250"
                    height="125"
                  >
                </div>
              {% else %}
                <div class="tji-logo-placeholder">
                  {{ 'logo' | placeholder_svg_tag: 'tji-placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  .tji-logo-slider-section {
    padding-top: {{ section.settings.padding_top_desktop }}px !important;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px !important;
    background-color: {{ section.settings.background_color }};
  }

  .tji-section-header {
    text-align: center;
  }

  .tji-section-heading {
    font-size: {{ section.settings.heading_font_size_desktop }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0;
    font-family: {{ section.settings.heading_font_family }};
  }

  .tji-logo-slider-wrapper {
    position: relative;
    overflow: hidden;
    padding: 20px 0;
  }

  .tji-logo-slider-track {
    display: flex;
    animation: tji-scrollLogos {{ section.settings.speed }}s linear infinite;
    gap: {{ section.settings.logo_gap }}px;
  }

  .tji-logo-slide {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
  }

  .tji-logo-image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    height: {{ section.settings.logo_height }}px;
    opacity: {{ section.settings.logo_opacity }}%;
  }

  .tji-logo-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: none !important;
  }

  .tji-logo-placeholder {
    width: 150px;
    height: 80px;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
  }

  /* Perfect Infinite scroll animation */
  @keyframes tji-scrollLogos {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Pause animation on hover */
  .tji-logo-slider-wrapper:hover .tji-logo-slider-track {
    animation-play-state: paused;
  }

  /* Mobile responsive */
  @media screen and (max-width: 768px) {
    .tji-logo-slider-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .tji-section-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
      letter-spacing: {{ section.settings.heading_letter_spacing_mobile }}px;
    }

    .tji-logo-slide {
      padding: 0 15px;
    }

    .tji-logo-image-wrapper {
      height: {{ section.settings.logo_height_mobile }}px;
    }
  }

  /* For very small screens */
  @media screen and (max-width: 480px) {
    .tji-logo-slider-track {
      gap: {{ section.settings.logo_gap_mobile }}px;
    }

    .tji-logo-slide {
      padding: 0 10px;
    }

    .tji-logo-image-wrapper {
      height: {{ section.settings.logo_height_mobile | times: 0.8 }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function tjiInitLogoSlider() {
      const sliderTracks = document.querySelectorAll('[data-tji-logo-slider]');
      
      sliderTracks.forEach(track => {
        // Remove any existing clones first
        const existingClones = track.querySelectorAll('[data-tji-clone="true"]');
        existingClones.forEach(clone => clone.remove());
        
        const originalSlides = track.querySelectorAll('.tji-logo-slide:not([data-tji-clone="true"])');
        const totalOriginalSlides = originalSlides.length;
        
        if (totalOriginalSlides > 0) {
          // Clone all original slides and append
          originalSlides.forEach(slide => {
            const clone = slide.cloneNode(true);
            clone.setAttribute('data-tji-clone', 'true');
            track.appendChild(clone);
          });
        }
      });
    }

    // Initialize
    tjiInitLogoSlider();

    // Re-initialize for Shopify editor
    document.addEventListener('shopify:section:load', function(e) {
      const slider = e.target.querySelector('[data-tji-logo-slider]');
      if (slider) {
        setTimeout(tjiInitLogoSlider, 100);
      }
    });
  });
</script>

