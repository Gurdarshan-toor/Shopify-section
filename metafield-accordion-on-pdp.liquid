<style>
.accordion {
  border-top: 1px solid #ddd;
}
.accordion-header {
  cursor: pointer;
  padding: 12px 0px;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-transform: uppercase !important;
  padding-bottom: 0px;
}
.accordion-header .arrow {
  width: 14px;
  height: 14px;
  transition: transform 0.3s ease;
}
.accordion-item.active .arrow {
  transform: rotate(180deg);
}

/* Smooth accordion */
.accordion-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease, padding 0.3s ease;
  padding: 0 0;
}
.accordion-item.active .accordion-content {
  max-height: 500px; /* large enough to fit content */
  padding: 10px 0;
}

.spec-table {
  width: 100%;
  border-collapse: collapse;
  margin: 10px 0;
}
.spec-table th,
.spec-table td {
  border: 1px solid #333;
  padding: 8px 12px;
  text-align: left;
}
.spec-table th {
  background-color: #f8f8f8;
  width: 40%;
}
</style>

<div class="accordion">

  {% assign show_specs = false %}
  {% if product.metafields.custom.weight_in_carats %}{% assign show_specs = true %}{% endif %}
  {% if product.metafields.custom.measurements_in_mm %}{% assign show_specs = true %}{% endif %}
  {% if product.metafields.custom.gemstone_variety %}{% assign show_specs = true %}{% endif %}
  {% if product.metafields.custom.cut %}{% assign show_specs = true %}{% endif %}
  {% if product.metafields.custom.shape %}{% assign show_specs = true %}{% endif %}
  {% if product.metafields.custom.carving_technique %}{% assign show_specs = true %}{% endif %}

  {% if show_specs %}
    <div class="accordion-item">
      <div class="accordion-header details__header">
        Specifications
        <span class="arrow">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 5.5L7 9.5L3 5.5" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
      <div class="accordion-content">
        <table class="spec-table">
          {% if product.metafields.custom.weight_in_carats %}
            <tr>
              <th>Weight in Carats</th>
              <td>{{ product.metafields.custom.weight_in_carats }}</td>
            </tr>
          {% endif %}
          {% if product.metafields.custom.measurements_in_mm %}
            <tr>
              <th>Measurements in mm</th>
              <td>{{ product.metafields.custom.measurements_in_mm }}</td>
            </tr>
          {% endif %}
          {% if product.metafields.custom.gemstone_variety %}
            {% assign gem = product.metafields.custom.gemstone_variety.value %}
            {% if gem %}
              <tr>
                <th>Gemstone Variety</th>
                <td>{{ gem.title }}</td>
              </tr>
            {% endif %}
          {% endif %}
          {% if product.metafields.custom.cut %}
            {% assign cut = product.metafields.custom.cut.value %}
            {% if cut %}
              <tr>
                <th>Cut</th>
                <td>{{ cut.title }}</td>
              </tr>
            {% endif %}
          {% endif %}
          {% if product.metafields.custom.shape %}
            {% assign shape = product.metafields.custom.shape.value %}
            {% if shape %}
              <tr>
                <th>Shape</th>
                <td>{{ shape.title }}</td>
              </tr>
            {% endif %}
          {% endif %}
          {% if product.metafields.custom.carving_technique %}
            <tr>
              <th>Carving Technique</th>
              <td>
                {% for carving in product.metafields.custom.carving_technique.value %}
                  {{ carving.title }}{% unless forloop.last %}, {% endunless %}
                {% endfor %}
              </td>
            </tr>
          {% endif %}
        </table>
      </div>
    </div>
  {% endif %}
</div>

<script>
document.querySelectorAll('.accordion-header').forEach(header => {
  header.addEventListener('click', () => {
    const item = header.parentElement;
    item.classList.toggle('active');
  });
});
</script>
