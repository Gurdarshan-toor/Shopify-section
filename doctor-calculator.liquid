
  <section id="shopify-section-template--17570798076015__peptide_calculator_JRfXEV" class="shopify-section section section-{{ section.id }}-padding"><section class="faq-section">
  <div class="w-layout-blockcontainer calculator w-container">
    <div class="calculdiv">
      <div class="w-embed w-iframe">
        <!---<div style="position: relative; width: 100%; padding-bottom: 120%; height: 575px; overflow: hidden; ">--->
        <div>
          <link rel="stylesheet" href="https://cdn.shopify.com/s/files/1/0948/8541/3175/files/calculator.css?v=1761717810">
<div class="main-container cus_container">
  <div class="cus_wrapper">
    <div class="peptide-calc-container">
      <!----><div class="topcontainer" "="">
      <div class="calc-phases">
        <div class="phase active">
          <div id="slider_wrapper">
            {% comment %} <h2 class="input_title">Size of your syringe:</h2> {% endcomment %}
            {% if section.settings.syringe_title !=blank %}
            <h2 class="input_title syrings_title">{{ section.settings.syringe_title }}</h2>
            {% endif %}
            <div id="syringe_size_slider">
              <input type="radio" name="syringe_size" id="1" value="1" required="">
              <label for="1" data-syringe-size="0.25ml"></label>
              <input type="radio" name="syringe_size" id="2" value="2" required="">
              <label for="2" data-syringe-size="0.5ml"></label>
              <input type="radio" name="syringe_size" id="3" value="3" required="" checked="">
              <label for="3" data-syringe-size="1ml"></label>
              <input type="radio" name="syringe_size" id="4" value="4" required="">
              <label for="4" data-syringe-size="2ml"></label>
              <input type="radio" name="syringe_size" id="5" value="5" required="">
              <label for="5" data-syringe-size="3ml"></label>
              <div id="syringe-size-pos"></div>
            </div>
          </div>
        </div>
        <div class="phase dry-medication" style="opacity: 0; visibility: hidden;">
          {% comment %} <h4 class="input_title">Total amount of dry medication in your vial:</h4> {% endcomment %}
          {% if section.settings.medication_title !=blank %}
            <h4 class="input_title medication_font_size">{{ section.settings.medication_title }}</h4>
            {% endif %}
          <div class="wrapper">
            <input id="dryMed" type="text" inputmode="numeric" pattern="\d*" class="naked" value="10" placeholder="10">
            <select id="dryMedUnit">
              <option value="g">g</option>
              <option value="mg" selected="">mg</option>
              <option value="mcg">mcg</option>
            </select>
          </div>
        </div>
        <div class="phase bacteriostatic-water" style="opacity: 0; visibility: hidden;">
          {% comment %} <h4 class="input_title">Total amount of bacteriostatic water you want to add:</h4> {% endcomment %}
           {% if section.settings.bacteriostatic_title !=blank %}
            <h4 class="input_title bacteriostatic_font_size">{{ section.settings.bacteriostatic_title }}</h4>
            {% endif %}
          <div class="wrapper">
            <input id="liquidAmount" type="text" inputmode="numeric" pattern="\d*" class="naked" value="1" placeholder="0-1">
            <span class="unit">ml</span>
          </div>
        </div>
        <div class="phase desired-dose" style="opacity: 0; visibility: hidden;">
          {% comment %} <h4 class="input_title">Desired dose:</h4> {% endcomment %}
          {% if section.settings.desired_title !=blank %}
            <h4 class="input_title desired_font_size">{{ section.settings.desired_title }}</h4>
            {% endif %}
          <div class="wrapper">
            <input id="desiredDose" type="text" inputmode="numeric" pattern="\d*" class="naked" value="500" placeholder="500">
            <select id="doseUnit">
              <option value="g">g</option>
              <option value="mg">mg</option>
              <option selected="" value="mcg">mcg</option>
            </select>
          </div>
        </div>
        <div class="phase result" style="opacity: 0; visibility: hidden;">
          {% comment %} <h4 class="input_title">Results:</h4> {% endcomment %}
           {% if section.settings.results_title !=blank %}
            <h4 class="input_title results_font_size">{{ section.settings.results_title }}</h4>
            {% endif %}
          <div class="wrapper">
            <span>Units per dose: </span>
            <span class="digit" id="unitsPerDose"></span>
          </div>
          <div class="wrapper">
            <span>Total Doses in Vial: </span>
            <span class="digit" id="totalDoses"></span>
          </div>
        </div>
      </div>
      <div class="nav-controls">
        <button class="pc-back disabled" data-phase="0">Back</button>
        <button class="pc-next">Next</button>
        <button class="pc-restart" style="display: none;">
          <div class="restart-icon"></div>
          <span>Restart</span>
        </button>
      </div>
