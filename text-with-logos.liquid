<!-- sections/ways-of-working.liquid -->
<div class="ways-of-working-section page-width" id="{{ section.id }}">
  <div class="ways-of-working-container">
    <!-- Main Heading -->
    <h2 class="section-main-heading">{{ section.settings.main_heading | default: "WAYS OF WORKING" }}</h2>
    
    <div class="ways-of-working-content">
      <!-- Left Column - Services -->
      <div class="services-column">
        {% for block in section.blocks %}
          {% if block.type == 'service' %}
            <div class="service-item" {{ block.shopify_attributes }}>
              <h3 class="service-title">{{ block.settings.service_title }}</h3>
              <div class="service-description">{{ block.settings.service_description }}</div>
              
              {% if block.settings.service_items != blank %}
                <ul class="service-items-list">
                  {% assign items = block.settings.service_items | split: '|' %}
                  {% for item in items %}
                    <li class="service-item-point">{{ item | strip }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Right Column - Experience -->
      <div class="experience-column" style="background-color: {{ section.settings.experience_background_color }}; padding: {{ section.settings.experience_padding }}px; border-radius: {{ section.settings.experience_border_radius }}px;">
        <h3 class="experience-heading">{{ section.settings.experience_heading | default: "EXPERIENCE WORKING WITH" }}</h3>
        
        <div class="brands-grid">
          {% for block in section.blocks %}
            {% if block.type == 'brand' %}
              <div class="brand-item" {{ block.shopify_attributes }}>
                {% if block.settings.brand_logo != blank %}
                  <div class="brand-logo">
                    <img 
                      src="{{ block.settings.brand_logo | img_url: '400x' }}" 
                      alt="{{ block.settings.brand_name | default: 'Brand' }}" 
                      loading="lazy"
                      width="{{ section.settings.brand_logo_width }}"
                      height="{{ section.settings.brand_logo_height }}"
                      style="max-width: {{ section.settings.brand_logo_max_width }}px; max-height: {{ section.settings.brand_logo_max_height }}px;"
                    >
                  </div>
                {% else %}
                  <div class="brand-name">{{ block.settings.brand_name }}</div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>

    #shopify-section-{{ section.id }}{
        display:unset !important;
    }
  .ways-of-working-section {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    background-color: {{ section.settings.background_color }};
    position: relative;
    width: 100%;
  }

  .ways-of-working-section.page-width {
    max-width: 100%;
  }

  .ways-of-working-container {
    max-width: {{ section.settings.section_max_width }}px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-main-heading {
    font-size: {{ section.settings.main_heading_font_size }}px;
    font-weight: {{ section.settings.main_heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-align: center;
    letter-spacing: {{ section.settings.main_heading_letter_spacing }}px;
    margin: 0 0 {{ section.settings.main_heading_margin_bottom }}px 0;
    line-height: 1.1;
  }

  .ways-of-working-content {
    display: flex;
    gap: {{ section.settings.columns_gap }}px;
    align-items: flex-start;
  }

  /* Services Column */
  .services-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.service_gap }}px;
  }

  .service-item {
    padding: {{ section.settings.service_padding }}px;
    background-color: {{ section.settings.service_background_color }};
    border-radius: {{ section.settings.service_border_radius }}px;
    border-left: {{ section.settings.service_accent_width }}px solid {{ section.settings.service_accent_color }};
  }

  .service-title {
    font-size: {{ section.settings.service_title_font_size }}px;
    font-weight: {{ section.settings.service_title_font_weight }};
    color: {{ section.settings.service_title_color }};
    letter-spacing: {{ section.settings.service_title_letter_spacing }}px;
    margin: 0 0 {{ section.settings.service_title_margin_bottom }}px 0;
    line-height: 1.2;
  }

  .service-description {
    font-size: {{ section.settings.service_description_font_size }}px;
    line-height: {{ section.settings.service_description_line_height }};
    color: {{ section.settings.service_description_color }};
    margin-bottom: {{ section.settings.service_description_margin_bottom }}px;
  }

  .service-items-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.service_items_gap }}px;
  }

  .service-item-point {
    font-size: {{ section.settings.service_items_font_size }}px;
    line-height: {{ section.settings.service_items_line_height }};
    color: {{ section.settings.service_items_color }};
    position: relative;
    padding-left: 16px;
  }

  .service-item-point::before {
    content: "•";
    position: absolute;
    left: 0;
    color: {{ section.settings.service_items_bullet_color }};
    font-size: 16px;
  }

  /* Experience Column - Sticky */
  .experience-column {
    flex: 0 0 {{ section.settings.experience_column_width }}%;
    position: sticky;
    top: {{ section.settings.sticky_top_position }}px;
    align-self: flex-start;
    transition: all 0.3s ease;
  }

  .experience-heading {
    font-size: {{ section.settings.experience_heading_font_size }}px;
    font-weight: {{ section.settings.experience_heading_font_weight }};
    color: {{ section.settings.experience_heading_color }};
    letter-spacing: {{ section.settings.experience_heading_letter_spacing }}px;
    margin: 0 0 {{ section.settings.experience_heading_margin_bottom }}px 0;
    text-align: center;
    line-height: 1.2;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.brands_per_row }}, 1fr);
    gap: {{ section.settings.brands_gap }}px;
  }

  .brand-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.brand_padding }}px;
    background-color: {{ section.settings.brand_background_color }};
    border-radius: {{ section.settings.brand_border_radius }}px;
    min-height: {{ section.settings.brand_min_height }}px;
    text-align: center;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .brand-logo img {
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .brand-name {
    font-size: {{ section.settings.brand_name_font_size }}px;
    font-weight: {{ section.settings.brand_name_font_weight }};
    color: {{ section.settings.brand_name_color }};
    text-transform: uppercase;
    letter-spacing: {{ section.settings.brand_name_letter_spacing }}px;
    line-height: 1.1;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .ways-of-working-content {
      flex-direction: column;
      gap: 40px;
    }

    .experience-column {
      flex: none;
      width: 100%;
      position: static;
    }

    .brands-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ways-of-working-container {
      padding: 0 1.5rem;
    }

    .ways-of-working-section {
      padding: {{ section.settings.section_padding_top_mobile }}px 0 {{ section.settings.section_padding_bottom_mobile }}px 0;
    }

    .section-main-heading {
      font-size: {{ section.settings.main_heading_font_size_mobile }}px;
    }

    .service-title {
      font-size: {{ section.settings.service_title_font_size_mobile }}px;
    }

    .experience-heading {
      font-size: {{ section.settings.experience_heading_font_size_mobile }}px;
    }
  }

  @media (max-width: 480px) {
    .ways-of-working-container {
      padding: 0 1rem;
    }

    .brands-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

