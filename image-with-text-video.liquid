
{%- capture sh_video_with_text_css -%}
  <style>
    #sh-{{ section.id }} {background: {{ section.settings.sec_bg_color }};}
    #sh-{{ section.id }} .sh-page-with {max-width: {{ section.settings.section_max_width }}px; width: 100%; padding: 0 20px; margin: 0 auto; }
    #sh-{{ section.id }}.sh-video-with-txt{padding:{{section.settings.padding_top}}px 0 {{section.settings.padding_bottom}}px 0;} 
    #sh-{{ section.id }} .sh-button { font-size: 16px; line-height: 1.65;background: {{section.settings.btn_bg_color}}; color: {{section.settings.btn_text_color}}; padding: 6px 20px; min-width: 140px; display: inline-block; border:1px solid {{section.settings.btn_border_color}};border-radius: {{section.settings.border_radius}}px;text-align: center; cursor:pointer;}
    #sh-{{ section.id }} .sh-button:hover{background: {{section.settings.btn_hover_bg_color}};color: {{section.settings.btn_hover_text_color}};border:1px solid {{section.settings.btn_hover_border_color}};box-shadow: 0 0 5px 0px {{section.settings.outline_btn_shadow_color}};} 
    #sh-{{ section.id }} .sh-button.sh-button-outline {color: {{section.settings.outline_btn_text_color}};border-color: {{section.settings.outline_btn_text_color}};background: transparent;}
    #sh-{{ section.id }} .sh-video-with-txt-heading {font-weight: 500;margin: 0 0 20px;font-size: {{ section.settings.title_font_size }}px;color: {{ section.settings.title_color }};}
    #sh-{{ section.id }} .sh-video-with-txt-grid {display: flex; flex-wrap:wrap;background: {{section.settings.bg_color}};gap:20px;border-radius: {{ section.settings.section_border_radius }}px;overflow: hidden; }
    #sh-{{ section.id }} .sh-video-with-txt-grid.sh-video-with-txt-left-media{flex-direction: row;}
    #sh-{{ section.id }} .sh-video-with-txt-grid.sh-video-with-txt-right-media{flex-direction: row-reverse;}     
    #sh-{{ section.id }} .sh-video-with-txt-text p {line-height: 1.5;margin:0 0 25px;font-size: {{ section.settings.content_font_size }}px;color: {{ section.settings.content_color }};}
    #sh-{{ section.id }} .sh-video-with-txt-video {flex: 0 0 50%;position: relative;} 
    #sh-{{ section.id }} .sh-video-with-txt-video video{position: absolute;top: 0;left: 0;right: 0;bottom: 0;width: 100%;height: 100%;object-fit: cover;object-position: center;}
  
    #sh-{{ section.id }} .sh-video-with-txt-video svg {position: absolute;top: calc(50% - 25px);left: calc(50% - 25px);cursor: pointer;transition: all .5s;visibility: hidden;opacity: 0;filter: drop-shadow(1px 1px 2px rgba(0, 0, 0, 0.25));width: 50px;height: 50px;}
    #sh-{{ section.id }} .sh-video-with-txt-video .sh-pause-button.sh-active-btn {opacity: 1;visibility: visible;}
    #sh-{{ section.id }} .sh-video-with-txt-video:hover .sh-play-button.sh-active-btn {opacity: 1;visibility: visible;}
    
    #sh-{{ section.id }} .sh-video-with-txt-video.sh-empty-img {background: grey;opacity: 0.3;}    
    #sh-{{ section.id }} .sh-video-with-txt-content {flex:0 0 calc(50% - 20px);display: flex; padding: 0 20px;} 
    #sh-{{ section.id }} .sh-video-with-txt-content.sh-video-with-txt-content-middle{align-items: center;} 
    #sh-{{ section.id }} .sh-video-with-txt-content.sh-video-with-txt-content-top{align-items: flex-start;}  
    #sh-{{ section.id }} .sh-video-with-txt-content.sh-video-with-txt-content-bottom{align-items: flex-end;}
    #sh-{{ section.id }} .sh-video-with-txt-content-in.sh-video-with-txt-align-center {text-align: center;}
    #sh-{{ section.id }} .sh-video-with-txt-content-in.sh-video-with-txt-align-left {text-align: left;} 
    #sh-{{ section.id }} .sh-video-with-txt-content-in.sh-video-with-txt-align-right {text-align: right;}
  
    #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-small {padding-bottom: 38%;}  
    #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-medium {padding-bottom: 44%;}  
    #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-large {padding-bottom: 50%;}    
    #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-adapt {padding-bottom: unset;}  
    #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-adapt video {position:relative;}  
    
    @media only screen and (max-width: 767px){
      #sh-{{ section.id }}.sh-video-with-txt{padding:{{section.settings.mob_padding_top}}px 0 {{section.settings.mob_padding_bottom}}px 0;} 
      #sh-{{ section.id }} .sh-video-with-txt-video {flex: 0 0 100%;}
      #sh-{{ section.id }} .sh-video-with-txt-content {flex: 0 0 100%;padding:20px;}   
      #sh-{{ section.id }} .sh-video-with-txt-heading {margin: 0 0 10px;font-size: 26px;}    
      #sh-{{ section.id }} .sh-video-with-txt-text p{font-size: 14px;margin:0 0 15px;}  
      #sh-{{ section.id }} .sh-video-with-txt-grid{gap:0;} 
      #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-large {padding-bottom: 120%;}  
      #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-medium {padding-bottom: 100%;}  
      #sh-{{ section.id }} .sh-video-with-txt-video.sh-img-small {padding-bottom: 80%;}        
      #sh-{{ section.id }} .sh-button { font-size: 15px;}
      #sh-{{ section.id }} .sh-video-with-txt-video svg {width: 40px;height: 40px;}
    }
  </style> 
{%- endcapture -%}
{{- sh_video_with_text_css | strip_newlines -}}

<div id="sh-{{ section.id }}" class="sh-video-with-txt">
  <div class="sh-page-with">
    <div class="sh-video-with-txt-grid sh-video-with-txt-{{ section.settings.image_align }}-media">
      <div class="sh-video-with-txt-video sh-img-{{ section.settings.image_size }}">
        {% if section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              image_size: 'master',
              playsinline: true,
              autoplay: section.settings.video_autoplay,
              loop: section.settings.video_loop,
              controls: section.settings.video_controls,
              muted: section.settings.video_muted
          }}          
        {% else %}
          <video playsinline="true"{% if section.settings.video_autoplay %} autoplay{% endif %}{% if section.settings.video_controls %} controls{% endif %}{% if section.settings.video_loop %} loop{% endif %}{% if section.settings.video_muted %} muted{% endif %} preload="metadata" poster="">
            <source src="https://cdn.shopify.com/videos/c/o/v/8cf086028a28474aa666c2665d04e016.mp4" type="video/mp4">
          </video>
        {% endif %}

        {% if section.settings.play_button and section.settings.video_controls == false %}
          <svg class="sh-pause-button sh-play-pause-button{% if section.settings.video_autoplay == false or section.settings.video_muted == false %} sh-active-btn{% endif %}" width="50px" height="50px" viewBox="0 0 90 90" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g id="media-grid" transform="translate(-325, -205)" fill="#FFFFFF" fill-rule="nonzero"><g transform="translate(40, 145)"><g transform="translate(230, 0)"><path d="M99.5,60 C105.655833,60 111.440833,61.168125 116.855,63.504375 C122.269167,65.840625 126.97875,69.01125 130.98375,73.01625 C134.98875,77.02125 138.159375,81.7308333 140.495625,87.145 C142.831875,92.5591667 144,98.3441667 144,104.5 C144,110.655833 142.831875,116.440833 140.495625,121.855 C138.159375,127.269167 134.98875,131.97875 130.98375,135.98375 C126.97875,139.98875 122.269167,143.159375 116.855,145.495625 C111.440833,147.831875 105.655833,149 99.5,149 C93.3441667,149 87.5591667,147.831875 82.145,145.495625 C76.7308333,143.159375 72.02125,139.98875 68.01625,135.98375 C64.01125,131.97875 60.840625,127.269167 58.504375,121.855 C56.168125,116.440833 55,110.655833 55,104.5 C55,98.3441667 56.168125,92.5591667 58.504375,87.145 C60.840625,81.7308333 64.01125,77.02125 68.01625,73.01625 C72.02125,69.01125 76.7308333,65.840625 82.145,63.504375 C87.5591667,61.168125 93.3441667,60 99.5,60 Z M90,85 L90,125 L121,105 L90,85 Z" id="Shape"></path></g></g></g></g></svg>
          <svg class="sh-play-button sh-play-pause-button{% if section.settings.video_autoplay and section.settings.video_muted == true %} sh-active-btn{% endif %}" width="50px" height="50px" viewBox="0 0 90 90" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g id="media-grid" transform="translate(-402, -205)" fill="#FFFFFF"><g id="Group-21" transform="translate(40, 145)"><g id="Group-20" transform="translate(230, 0)"><path d="M176.5,60 C182.655833,60 188.440833,61.168125 193.855,63.504375 C199.269167,65.840625 203.97875,69.01125 207.98375,73.01625 C211.98875,77.02125 215.159375,81.7308333 217.495625,87.145 C219.831875,92.5591667 221,98.3441667 221,104.5 C221,110.655833 219.831875,116.440833 217.495625,121.855 C215.159375,127.269167 211.98875,131.97875 207.98375,135.98375 C203.97875,139.98875 199.269167,143.159375 193.855,145.495625 C188.440833,147.831875 182.655833,149 176.5,149 C170.344167,149 164.559167,147.831875 159.145,145.495625 C153.730833,143.159375 149.02125,139.98875 145.01625,135.98375 C141.01125,131.97875 137.840625,127.269167 135.504375,121.855 C133.168125,116.440833 132,110.655833 132,104.5 C132,98.3441667 133.168125,92.5591667 135.504375,87.145 C137.840625,81.7308333 141.01125,77.02125 145.01625,73.01625 C149.02125,69.01125 153.730833,65.840625 159.145,63.504375 C164.559167,61.168125 170.344167,60 176.5,60 Z M167.073333,88 C164.823693,88 163,89.8236935 163,92.0733333 L163,119.926667 C163,122.176307 164.823693,124 167.073333,124 C169.322973,124 171.146667,122.176307 171.146667,119.926667 L171.146667,92.0733333 C171.146667,89.8236935 169.322973,88 167.073333,88 Z M185.873333,88 C183.623693,88 181.8,89.8236935 181.8,92.0733333 L181.8,119.926667 C181.8,122.176307 183.623693,124 185.873333,124 C188.122973,124 189.946667,122.176307 189.946667,119.926667 L189.946667,92.0733333 C189.946667,89.8236935 188.122973,88 185.873333,88 Z" id="Combined-Shape"></path></g></g></g></g></svg>
        {% endif %}
      </div>
      
      {% if section.settings.title != blank or section.settings.content != blank or section.settings.btn_txt != blank %}
        <div class="sh-video-with-txt-content sh-video-with-txt-content-middle">
          <div class="sh-video-with-txt-content-in sh-video-with-txt-align-{{ section.settings.text_align }}">
            {% if section.settings.title != blank %}
              <h2 class="sh-video-with-txt-heading">{{ section.settings.title }}</h2>
            {% endif %}
            
            {% if section.settings.content != blank %}
              <div class="sh-video-with-txt-text">
                {{ section.settings.content }}
              </div>
            {% endif %}
            
            {% if section.settings.btn_txt != blank and section.settings.btn_link != blank %}
              <a href="{{ section.settings.btn_link }}" class="sh-button{% if section.settings.btn_outline %} sh-button-outline{% endif %}">
                {{- section.settings.btn_txt -}}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  {% if section.settings.play_button %}
    var spScrollVideo = document.querySelectorAll(`#sh-{{ section.id }} .sh-video-with-txt-video video`);
    if(spScrollVideo.length > 0){
      for(var x=0; x<spScrollVideo.length; x++) {
        spScrollVideo[x].closest(".sh-video-with-txt-video").querySelectorAll(".sh-play-pause-button").forEach(playPauseBtn => {
          playPauseBtn.addEventListener("click", function(){
            this.closest(".sh-video-with-txt-video").querySelector(".sh-active-btn").classList.remove("sh-active-btn");
              if(this.closest(".sh-video-with-txt-video").querySelector("video").paused){
                this.closest(".sh-video-with-txt-video").querySelector(".sh-play-button").classList.add("sh-active-btn");
                this.closest(".sh-video-with-txt-video").querySelector("video").play();
              }else{
                this.closest(".sh-video-with-txt-video").querySelector(".sh-pause-button").classList.add("sh-active-btn");
                this.closest(".sh-video-with-txt-video").querySelector("video").pause();
              }
          });
        });
      }
    }
  {% endif %}
</script>

