<!-- snippets/color-popup.liquid -->
<div id="color-popup" class="color-popup" style="display: none;">
  <!-- Content will be moved to body by JavaScript -->
</div>

<template id="popup-template">
  <div class="popup-overlay"></div>
  <div class="popup-content">
    <!-- Header Section -->
    <div class="popup-header">
      <h3>Sammenlign farver</h3>
      <button class="close-popup">&times;</button>
    </div>
    
    <!-- Tab Buttons -->
    <div class="tab-buttons">
      <button class="tab-button active" data-tab="tip">Tip</button>
      <button class="tab-button" data-tab="hand">Hånd</button>
    </div>
    
    <hr class="divider">
    
    <!-- Products Row - Current Product + Selected Products -->
    <div class="products-row-section">
      <h4 class="section-title">Nuværende og valgte produkter</h4>
      <div class="products-row-container">
        <!-- Current Product -->
        <div class="current-product-item">
          <div class="product-image">
            <img id="current-product-img" src="{{ product.featured_image | img_url: 'large' }}" alt="{{ product.title }}" 
                 data-tip-image="{{ product.images.first | img_url: 'large' }}" 
                 data-hand-image="{% if product.images[1] %}{{ product.images[1] | img_url: 'large' }}{% else %}{{ product.images.first | img_url: 'large' }}{% endif %}">
          </div>
          <div class="product-title">
            <h4>{{ product.title }}</h4>
          </div>
        </div>
        
        <!-- Selected Products Container -->
        <div class="selected-products-container" id="selected-products">
          <!-- Selected products will be added here dynamically -->
          <div class="empty-state">
            Klik på produkter nedenfor for at tilføje
          </div>
        </div>
      </div>
    </div>

    <!-- Available Products Section -->
    <div class="available-products-section">
      <h4 class="section-title">Tilgængelige farver</h4>
      
      <!-- Available Products Grid -->
      <div class="available-products-grid">
        {% assign builder_gel_collection = collections['builder-gel'] %}
        {% if builder_gel_collection %}
          {% for product in builder_gel_collection.products %}
            <div class="available-product-item" 
                 data-product-handle="{{ product.handle }}" 
                 data-product-title="{{ product.title }}"
                 data-product-url="{{ product.url }}"
                 data-product-tip-image="{{ product.featured_image | img_url: 'large' }}"
                 data-product-hand-image="{% if product.images[1] %}{{ product.images[1] | img_url: 'large' }}{% else %}{{ product.featured_image | img_url: 'large' }}{% endif %}">
              <div class="product-image-small">
                <img src="{{ product.featured_image | img_url: '100x100' }}" alt="{{ product.title }}" loading="lazy">
              </div>
              <p class="product-name">{{ product.title }}</p>
            </div>
          {% endfor %}
        {% else %}
          <div class="no-collection">Builder Gel samling ikke fundet</div>
        {% endif %}
      </div>
    </div>
  </div>
</template>

<style>
/* NUCLEAR RESET - Remove all theme conflicts */
body.popup-active {
  overflow: hidden !important;
  height: 100vh !important;
}

body.popup-active *:not(.popup-overlay):not(.popup-content):not(.popup-header):not(.color-popup) {
  z-index: auto !important;
}

/* Popup Container */
.color-popup {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 999999 !important;
  display: none;
}

/* Overlay - Cover entire screen */
.popup-overlay {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background: rgba(0, 0, 0, 0.8) !important;
  z-index: 999998 !important;
}

/* Popup Content - Center of screen */
.popup-content {
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  width: 95vw !important;
  max-width: 1200px !important;
  max-height: 90vh !important;
  background: white !important;
  border-radius: 12px !important;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3) !important;
  overflow: auto !important;
  z-index: 999999 !important;
  overflow-x: hidden !important;
}

/* Header - Always on top */
.popup-header {
  position: sticky !important;
  top: 0 !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  padding: 20px 25px !important;
  border-bottom: 1px solid #e5e5e5 !important;
  background: white !important;
  z-index: 1000 !important;
  border-radius: 12px 12px 0 0 !important;
}

.popup-header h3 {
  margin: 0 !important;
  font-size: 22px !important;
  font-weight: 700 !important;
  color: #2c3e50 !important;
}

.close-popup {
  background: none !important;
  border: none !important;
  font-size: 28px !important;
  cursor: pointer !important;
  padding: 0 !important;
  width: 35px !important;
  height: 35px !important;
  display: flex !important;
  align-items: center !important;
