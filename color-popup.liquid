</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  let popupInstance = null;
  let activeTab = 'tip';

  // Global function to open popup
  window.openColorPopup = function() {
    createPopup();
  };

  function createPopup() {
    // Remove existing popup if any
    if (popupInstance) {
      popupInstance.remove();
    }

    // Get template
    const template = document.getElementById('popup-template');
    const popupContent = template.content.cloneNode(true);
    
    // Create new popup container and append to body
    popupInstance = document.createElement('div');
    popupInstance.id = 'dynamic-color-popup';
    popupInstance.className = 'color-popup';
    popupInstance.style.cssText = `
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      z-index: 999999 !important;
      display: block !important;
    `;
    
    popupInstance.appendChild(popupContent);
    document.body.appendChild(popupInstance);
    
    // Add body class
    document.body.classList.add('popup-active');
    document.body.style.overflow = 'hidden';
    
    // Initialize functionality
    initializePopup();
  }

  function initializePopup() {
    const popup = document.getElementById('dynamic-color-popup');
    if (!popup) return;

    const closeBtn = popup.querySelector('.close-popup');
    const overlay = popup.querySelector('.popup-overlay');
    const tabButtons = popup.querySelectorAll('.tab-button');
    const currentProductImage = popup.querySelector('#current-product-img');
    const selectedProductsContainer = popup.querySelector('#selected-products');

    // Close functionality
    if (closeBtn) {
      closeBtn.addEventListener('click', closePopup);
    }
    
    if (overlay) {
      overlay.addEventListener('click', closePopup);
    }

    // Tab functionality
    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        tabButtons.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
        activeTab = this.getAttribute('data-tab');
        updateAllProductImages();
      });
    });

    // Available products
    const availableProducts = popup.querySelectorAll('.available-product-item');
    availableProducts.forEach(product => {
      product.addEventListener('click', function() {
        const productUrl = this.getAttribute('data-product-url');
        const productTitle = this.getAttribute('data-product-title');
        const productTipImage = this.getAttribute('data-product-tip-image');
        const productHandImage = this.getAttribute('data-product-hand-image');
        const productHandle = this.getAttribute('data-product-handle');
        
        addProductToSelected(productHandle, productTitle, productTipImage, productHandImage, productUrl);
      });
    });

    // Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && popupInstance) {
        closePopup();
      }
    });

    // Force z-index every second
    const zIndexInterval = setInterval(() => {
      if (popupInstance) {
        popupInstance.style.zIndex = '999999';
        const content = popup.querySelector('.popup-content');
        const overlay = popup.querySelector('.popup-overlay');
        const header = popup.querySelector('.popup-header');
        
        if (content) content.style.zIndex = '999999';
        if (overlay) overlay.style.zIndex = '999998';
        if (header) header.style.zIndex = '1000';
      } else {
        clearInterval(zIndexInterval);
      }
    }, 1000);
  }

  function closePopup() {
    if (popupInstance) {
      popupInstance.remove();
      popupInstance = null;
    }
    document.body.classList.remove('popup-active');
    document.body.style.overflow = 'auto';
  }

  function updateAllProductImages() {
    const popup = document.getElementById('dynamic-color-popup');
    if (!popup) return;

    const currentProductImage = popup.querySelector('#current-product-img');
    const selectedProductsContainer = popup.querySelector('#selected-products');

    if (currentProductImage) {
      const imageSrc = currentProductImage.getAttribute(`data-${activeTab}-image`);
      if (imageSrc) currentProductImage.src = imageSrc;
    }
    
    const selectedProducts = selectedProductsContainer.querySelectorAll('.selected-product-item');
    selectedProducts.forEach(product => {
      const productImage = product.querySelector('.product-image img');
      const tipImage = product.getAttribute('data-tip-image');
      const handImage = product.getAttribute('data-hand-image');
      
      if (productImage) {
        const newImageSrc = activeTab === 'tip' ? tipImage : handImage;
        if (newImageSrc) productImage.src = newImageSrc;
      }
    });
  }

  function addProductToSelected(productId, productTitle, productTipImage, productHandImage, productUrl) {
    const popup = document.getElementById('dynamic-color-popup');
    if (!popup) return;

    const selectedProductsContainer = popup.querySelector('#selected-products');
    if (!selectedProductsContainer) return;
    
    // Remove empty state if exists
    const emptyState = selectedProductsContainer.querySelector('.empty-state');
    if (emptyState) {
        emptyState.remove();
    }
    
    // STRICT DUPLICATE CHECKING - NO DUPLICATES ALLOWED
    const currentProductTitle = '{{ product.title | escape }}';
    
    // Check 1: Don't allow current product to be added
    if (productTitle.trim().toLowerCase() === currentProductTitle.trim().toLowerCase()) {
        return; // Current product cannot be added
    }
    
    // Check 2: Don't allow same product ID
    const existingById = selectedProductsContainer.querySelector(`[data-product-id="${productId}"]`);
    if (existingById) {
        return; // Product already exists
    }
    
    // Check 3: Don't allow same product title in selected items
    const allSelectedProducts = selectedProductsContainer.querySelectorAll('.selected-product-item');
    let isDuplicate = false;
    
    allSelectedProducts.forEach(item => {
        const itemTitle = item.querySelector('.product-title h4').textContent.trim().toLowerCase();
        if (itemTitle === productTitle.trim().toLowerCase()) {
            isDuplicate = true;
        }
    });
    
    if (isDuplicate) {
        return; // Duplicate product title found
    }
    
    // Create new product element
    const productElement = document.createElement('div');
    productElement.className = 'selected-product-item';
    productElement.setAttribute('data-product-id', productId);
    productElement.setAttribute('data-product-url', productUrl);
    productElement.setAttribute('data-tip-image', productTipImage);
    productElement.setAttribute('data-hand-image', productHandImage);
    
    const initialImage = activeTab === 'tip' ? productTipImage : productHandImage;
    
    productElement.innerHTML = `
      <div class="product-image">
        <img src="${initialImage}" alt="${productTitle}">
        <button class="remove-product" title="Fjern produkt">×</button>
      </div>
      <div class="product-title">
        <h4>${productTitle}</h4>
      </div>
    `;
    
    productElement.addEventListener('click', function(e) {
      if (!e.target.classList.contains('remove-product')) {
        const url = this.getAttribute('data-product-url');
        window.open(url, '_blank');
      }
    });
    
    const removeBtn = productElement.querySelector('.remove-product');
    removeBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      productElement.remove();
      if (selectedProductsContainer.children.length === 0) {
        selectedProductsContainer.innerHTML = '<div class="empty-state">Klik på produkter nedenfor for at tilføje</div>';
      }
    });
    
    selectedProductsContainer.appendChild(productElement);
  }
});
</script>
