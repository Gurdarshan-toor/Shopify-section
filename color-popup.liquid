  z-index: 10;
}

.selected-product-item:hover .remove-product {
  opacity: 1;
}

.remove-product:hover {
  background: #e74c3c;
  transform: scale(1.1);
}

.available-products-section {
  padding: 25px;
}

.available-products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
