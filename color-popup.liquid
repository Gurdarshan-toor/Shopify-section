}

.divider {
  margin: 0 25px;
  border: none;
  border-top: 1px solid #e5e5e5;
}

.products-row-section {
  padding: 20px 25px;
  border-bottom: 1px solid #e5e5e5;
}

.section-title {
  margin: 0 0 25px 0;
  font-size: 18px;
  font-weight: 600;
  color: #2c3e50;
  text-align: center;
}

.products-row-container {
  display: flex;
  align-items: flex-start;
  gap: 30px;
  flex-wrap: nowrap;
