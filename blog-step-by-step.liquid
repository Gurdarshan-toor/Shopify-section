<div class="step-by-step-grid-smooth">
  {%- if article.metafields.custom.main_heading != blank -%}
      <h2 class="main-heading-smooth">
      {{ article.metafields.custom.main_heading }}
    </h2>
    {%- endif -%}
  
  {% comment %} <div class="steps-grid-container-smooth">
    {%- assign steps = shop.metaobjects.step_by_step_guide.values -%}
    
    {%- for step in steps -%}
      <div class="step-grid-card-smooth">
        <!-- 1. Image -->
        {%- if step.step_image -%}
          <div class="step-grid-image-smooth">
            <img src="{{ step.step_image | img_url: '350x250', crop: 'center' }}" 
                 alt="{{ step.step_title }}" 
                 class="grid-image-smooth"
                 loading="lazy"
                 width="350"
                 height="250">
          </div>
        {%- endif -%}
        
        <!-- 2. Title with Number -->
        <div class="step-grid-header-smooth">
          <div class="step-grid-number-smooth">{{ forloop.index }}</div>
          <h3 class="step-grid-title-smooth">{{ step.step_title }}</h3>
        </div>
        
        <!-- 3. Description -->
        <div class="step-grid-description-smooth">
          <div class="grid-short-desc-smooth">
            {{ step.step_description | strip_html | truncatewords: 25, "..." }}
          </div>
          <div class="grid-full-desc-smooth">
            {{ step.step_description }}
          </div>
        </div>
        
        <!-- 4. Read More -->
        <div class="step-grid-actions-smooth">
          {%- if step.read_more_link -%}
            <a href="{{ step.read_more_link }}" class="grid-read-more-simple">Read more</a>
          {%- endif -%}
          <button class="grid-toggle-btn-simple" data-step="{{ forloop.index }}">
            <span class="grid-show-more-simple">Read more</span>
            <span class="grid-show-less-simple">Show less</span>
          </button>
        </div>
      </div>
    {%- endfor -%}
  </div> {% endcomment %}


 
