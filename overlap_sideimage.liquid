<!-- sections/why-jackie.liquid -->
{% comment %} {{ 'why-jackie.css' | asset_url | stylesheet_tag }} {% endcomment %}

<div class="why-jackie-section" id="{{ section.id }}">
  <div class="why-jackie-container">
    {% if section.settings.heading != blank %}
      <h2 class="why-jackie-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="why-jackie-content">
      <div class="why-jackie-image-wrapper">
        {% if section.settings.image != blank %}
          <img 
            src="{{ section.settings.image | img_url: '800x' }}" 
            alt="{{ section.settings.image.alt | escape }}" 
            class="why-jackie-image"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% else %}
          <div class="why-jackie-placeholder">
            {{ 'image' | placeholder_svg_tag: 'why-jackie-placeholder-svg' }}
          </div>
        {% endif %}
      </div>
      
      <div class="why-jackie-features">
        {% for block in section.blocks %}
          <div class="why-jackie-feature" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="why-jackie-icon">
                <img 
                  src="{{ block.settings.icon | img_url: '100x' }}" 
                  alt="{{ block.settings.icon.alt | escape }}"
                  loading="lazy"
                  width="50"
                  height="50"
                >
              </div>
            {% endif %}
            
            <div class="why-jackie-feature-content">
              {% if block.settings.title != blank %}
                <h3 class="why-jackie-feature-title">{{ block.settings.title }}</h3>
              {% endif %}
              
              {% if block.settings.description != blank %}
                <div class="why-jackie-feature-description">{{ block.settings.description }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
    #shopify-section-{{ section.id }}{
        display:unset !important;
    }
   .why-jackie-section {
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_right }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left }}px;
    {% if section.settings.background_type == 'color' %}
      background-color: {{ section.settings.background_color }};
    {% elsif section.settings.background_type == 'gradient' %}
      background: linear-gradient(to {{ section.settings.gradient_direction }}, {{ section.settings.gradient_color_1 }} {{ section.settings.gradient_position_1 }}%, {{ section.settings.gradient_color_2 }} {{ section.settings.gradient_position_2 }}%);
    {% endif %}
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
  }

  .why-jackie-container {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  {% if section.settings.background_overlay_enable %}
  .why-jackie-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 0;
  }
  {% endif %}

  
  .why-jackie-heading {
    text-align: {{ section.settings.heading_alignment }};
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    position: absolute;
    top: 7%;
    left: 45%;
  }
  
  .why-jackie-content {
    {% comment %} display: flex;
    flex-wrap: wrap; {% endcomment %}
    display: grid;
    grid-template-columns: 45% 55%;
    align-items: center;
    gap: {{ section.settings.content_gap }}px;
  }
  
  .why-jackie-image-wrapper {
    flex: 1;
    min-width: 300px;
  }
  
  .why-jackie-image {
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
    object-fit: contain;
    max-height: {{ section.settings.image_max_height }}px;
  }
  
  .why-jackie-placeholder {
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    height: {{ section.settings.image_max_height }}px;
    border-radius: {{ section.settings.image_border_radius }}px;
  }
  
  .why-jackie-placeholder-svg {
    width: 100%;
    height: 100%;
  }
  
  .why-jackie-features {
    flex: 1;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.feature_gap }}px;
  }
  
  .why-jackie-feature {
    display: flex;
    align-items: Center;
    gap: {{ section.settings.icon_text_gap }}px;
    padding: {{ section.settings.feature_padding }}px;
    background-color: {{ section.settings.feature_background_color }};
    border-radius: {{ section.settings.feature_border_radius }}px;
  }
  
  .why-jackie-icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .why-jackie-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  .why-jackie-feature-title {
    margin: 0 0 8px 0;
    color: {{ section.settings.feature_title_color }};
    font-size: {{ section.settings.feature_title_font_size }}px;
  }
  
  .why-jackie-feature-description {
    color: {{ section.settings.feature_description_color }};
    font-size: {{ section.settings.feature_description_font_size }}px;
    line-height: 1.5;
    text-transform: uppercase;
    font-weight: 700;
  }
  
  @media (max-width: 768px) {
    .i-believe-work .work-heading {
      font-size: 32px;
  }
    .why-jackie-features {
      padding-top: 20px;
  }  
     .why-jackie-content {
    display: unset;
  }
  .why-jackie-image {
        padding-top: 80px;
        max-height: 600px;
   }
   .why-jackie-feature-description {
        font-size: 18px;
        line-height: 1.2;
   }
   .why-jackie-heading {
        top: 0%;
        left: 30%;
    }
    .why-jackie-content {
      flex-direction: column;
    }
    
    .why-jackie-section {
      padding: {{ section.settings.section_padding_top_mobile }}px {{ section.settings.section_padding_right_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px {{ section.settings.section_padding_left_mobile }}px;
    }
    
    .why-jackie-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }
  }
</style>

{% schema %}
{
